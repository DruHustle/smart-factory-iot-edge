[Unit]
Description=Smart Factory Edge Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/smart-factory-iot-edge/raspberry-pi
EnvironmentFile=/opt/smart-factory-iot-edge/raspberry-pi/.env
ExecStart=/usr/bin/python3 /opt/smart-factory-iot-edge/raspberry-pi/src/sensor_gateway.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
